# Copy to .env.test.local (gitignored) and fill in from `npx supabase status`
# (or the block printed at the end of `npx supabase start`) once the local
# stack is running. These are local-dev-only keys — never production
# secrets — but .env.test.local stays out of git regardless, as a habit.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
